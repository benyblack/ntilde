<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Ratchet (#108): warning-free today, so lock it in. See the repo-wide default in
         Directory.Build.props, which stays false until the noisy projects are cleaned.
         Verified on a clean full rebuild after clearing the McpServer file lock (#211) -
         the lock had been masking this project entirely, since it cannot build until
         Ntilde.McpServer does. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <!-- MCP client (StdioClientTransport / McpClient) for the e2e handshake test. -->
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ntilde.McpServer\Ntilde.McpServer.csproj" />
    <ProjectReference Include="..\..\src\Ntilde.VtContract\Ntilde.VtContract.csproj" />
    <!-- Test-only: the drift guard reflects over the real profile types. The MCP server
         itself must never reference Ntilde.Platform. -->
    <ProjectReference Include="..\..\src\Ntilde.Platform\Ntilde.Platform.csproj" />
    <!-- Test-only, same argument: SettingsToolsDriftGuardTests reflects over the real
         TerminalSettings so the hand-mirrored field lists in SettingsTools cannot go stale
         (PR #293 review). The MCP server itself must never reference Ntilde.App -
         settings validation is a schema check, not a call into the app. -->
    <ProjectReference Include="..\..\src\Ntilde.App\Ntilde.App.csproj" />
  </ItemGroup>

</Project>
