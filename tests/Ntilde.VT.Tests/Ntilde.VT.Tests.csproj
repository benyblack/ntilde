<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Ratchet (#108): this project builds warning-free today, so lock that in. The
         repo-wide default in Directory.Build.props stays false until the remaining
         projects are cleaned up; opting in per project keeps a clean project from
         silently regressing while the noisy ones are still being worked through. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ntilde.VT\Ntilde.VT.csproj" />
    <ProjectReference Include="..\..\src\Ntilde.VtContract\Ntilde.VtContract.csproj" />
    <!-- BufferSnapshot.Capture is the comparison the parity test is specified in terms of, and
         ReplayReader parses the .rec corpus. Replay depends only on VT, so this adds no layering
         risk; the arch tests constrain production assemblies, not test ones. -->
    <ProjectReference Include="..\..\src\Ntilde.Replay\Ntilde.Replay.csproj" />
    <!-- Utf8ChunkDecoder is the production type whose (ConsumedBytes, PendingTail) semantics the
         snapshot's stream position is defined in terms of, and ParityHarness's ParityRun mirrors
         it. The mirror is only trustworthy if the two are differentially compared, which needs the
         real type in scope - see ParityRunDecoderEquivalenceTests. Same reasoning as the Replay
         reference above: the arch tests constrain production assemblies, not test ones, and
         nothing in Ntilde.Pty is reachable from Ntilde.VT as a result. -->
    <ProjectReference Include="..\..\src\Ntilde.Pty\Ntilde.Pty.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same replay v2 fixtures the App.Tests ReplayRunner suites use. Linked, not copied:
         one corpus, so a fixture fixed in one place is fixed for both. -->
    <Content Include="..\Ntilde.App.Tests\Fixtures\Replay\*.rec">
      <Link>Fixtures/Replay/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
