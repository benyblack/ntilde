<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Assembly name keeps the .App.Tests convention so InternalsVisibleTo targets resolve,
         but the root namespace avoids creating a `Ntilde.App` namespace prefix that
         would shadow the App class defined in `namespace Ntilde`. -->
    <AssemblyName>Ntilde.App.Tests</AssemblyName>
    <RootNamespace>Ntilde.AppTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="corpus\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ntilde.App\Ntilde.App.csproj" />
    <ProjectReference Include="..\..\src\Ntilde.Cli\Ntilde.Cli.csproj" />
    <ProjectReference Include="..\..\src\Ntilde.Conformance\Ntilde.Conformance.csproj" />
    <ProjectReference Include="..\..\src\Ntilde.Mux\Ntilde.Mux.csproj" />
    <ProjectReference Include="..\..\src\Ntilde.Mux.Contracts\Ntilde.Mux.Contracts.csproj" />
    <!-- ntilde.com (Phase 4 spec §11): the tests call LauncherCommandLine and copy the launcher's build,
         which this reference puts beside them, next to a fake Ntilde.exe (LauncherEndToEndTests). -->
    <ProjectReference Include="..\..\src\Ntilde.Launcher\Ntilde.Launcher.csproj" ReferenceOutputAssembly="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mux test support, shared with Ntilde.Mux.Tests (Phase 2 plan, Task 5). -->
    <Compile Include="..\Ntilde.Mux.Tests\Support\ScriptedSessionFactory.cs" Link="MuxSupport\ScriptedSessionFactory.cs" />
    <Compile Include="..\Ntilde.Mux.Tests\Support\ScriptedTerminalSession.cs" Link="MuxSupport\ScriptedTerminalSession.cs" />
    <Compile Include="..\Ntilde.Mux.Tests\Support\NoTapTerminalSession.cs" Link="MuxSupport\NoTapTerminalSession.cs" />
    <Compile Include="..\Ntilde.Mux.Tests\Support\TestWait.cs" Link="MuxSupport\TestWait.cs" />
    <Compile Include="..\Ntilde.Mux.Tests\Support\ClientPaneModel.cs" Link="MuxSupport\ClientPaneModel.cs" />
    <Compile Include="..\Ntilde.Mux.Tests\Support\RawMuxConnection.cs" Link="MuxSupport\RawMuxConnection.cs" />
    <Compile Include="..\Ntilde.Mux.Tests\Support\MuxTestHost.cs" Link="MuxSupport\MuxTestHost.cs" />
    <Compile Include="..\Ntilde.Mux.Tests\Support\ParserFaultInjection.cs" Link="MuxSupport\ParserFaultInjection.cs" />
    <Compile Include="..\Ntilde.Mux.Tests\Support\FakeConsoleSurface.cs" Link="MuxSupport\FakeConsoleSurface.cs" />
    <Compile Include="..\Ntilde.Mux.Tests\Support\FakeMuxServerEnd.cs" Link="MuxSupport\FakeMuxServerEnd.cs" />
    <Compile Include="..\Ntilde.Mux.Tests\Support\FullSendQueue.cs" Link="MuxSupport\FullSendQueue.cs" />
    <Compile Include="..\Ntilde.VT.Tests\StateTransfer\TerminalStateAssert.cs" Link="MuxSupport\TerminalStateAssert.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Docker sshd fixture, shared with Ntilde.Platform.Tests (Phase 4 spec §12.3): RemoteMuxDockerE2eTests
         drives the remote multiplexer against the same image. Their namespaces stay Ntilde.Platform.Tests.*. -->
    <Compile Include="..\Ntilde.Platform.Tests\Ssh\DockerSshFixture.cs" Link="DockerSupport\DockerSshFixture.cs" />
    <Compile Include="..\Ntilde.Platform.Tests\Ssh\NativeSshTestInteractionHandler.cs" Link="DockerSupport\NativeSshTestInteractionHandler.cs" />
    <Compile Include="..\Ntilde.Platform.Tests\Infra\DockerFactAttribute.cs" Link="DockerSupport\DockerFactAttribute.cs" />
  </ItemGroup>

</Project>
