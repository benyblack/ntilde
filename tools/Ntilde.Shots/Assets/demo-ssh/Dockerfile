# The remote machine for the remote-files and transfers scenarios: a throwaway sshd the harness
# starts on 127.0.0.1 for one run (DemoSshHost), so the SFTP sidebar lists a real directory over a
# real native SSH session and the transfer UI shows real bytes moving. Nothing here is the
# developer's: user dev, host edge-01, and a fabricated home directory.
#
# No key material is baked in, as in tests/Ntilde.ExternalSuites/NativeSsh/Dockerfile: host keys are
# generated by the entrypoint at container start, and DemoSshHost generates dev's login key inside
# the running container and copies the private half out. The container runs with --rm.
FROM debian:12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-server bash \
    && rm -rf /var/lib/apt/lists/*

# Debian's skeleton .profile and .bash_logout only add dated noise to the sidebar listing.
RUN useradd -m -s /bin/bash dev \
    && rm -f /home/dev/.profile /home/dev/.bash_logout \
    && mkdir -p /home/dev/.ssh /var/run/sshd \
    && chmod 700 /home/dev/.ssh

RUN printf '%s\n' \
        'PasswordAuthentication no' \
        'PubkeyAuthentication yes' \
        'KbdInteractiveAuthentication no' \
        'PermitRootLogin no' \
        'UseDNS no' \
        'PrintMotd no' \
        'PrintLastLog no' \
        > /etc/ssh/sshd_config.d/ntilde-shots.conf \
    && rm -f /etc/motd /etc/update-motd.d/*

# The same powerline style as the local demo prompt (tools/Ntilde.Shots/DemoWorld.cs), with the
# remote host in the first segment and no git segment.
COPY bashrc /home/dev/.bashrc
RUN printf 'if [ -f ~/.bashrc ]; then . ~/.bashrc; fi\n' > /home/dev/.bash_profile

# A believable deploy box to browse. Sizes are what make the listing read as real; the large
# release archive is created sparse at container start so the image stays small.
RUN cd /home/dev \
    && mkdir -p releases/0.12.4 releases/0.13.0 logs backups config/nginx www/assets \
    && printf 'ntilde deploy box\n' > README.md \
    && printf 'services:\n  web:\n    image: nginx:1.27\n' > docker-compose.yml \
    && head -c 48213 /dev/urandom > releases/0.12.4/ntilde-0.12.4-linux-x64.tar.gz \
    && head -c 51877 /dev/urandom > releases/0.13.0/ntilde-0.13.0-linux-x64.tar.gz \
    && for d in 27 28 29 30 31; do head -c $((d * 3911)) /dev/urandom | base64 > logs/access-2026-10-$d.log; done \
    && head -c 20480 /dev/urandom > backups/db-2026-10-31.sql.gz \
    && printf 'server { listen 80; }\n' > config/nginx/default.conf \
    && printf '<!doctype html><title>edge-01</title>\n' > www/index.html \
    && chown -R dev:dev /home/dev

RUN printf '%s\n' \
        '#!/bin/sh' \
        'set -e' \
        'ssh-keygen -A >/dev/null' \
        'truncate -s 1800M /home/dev/releases/0.13.0/ntilde-0.13.0-full-images.tar' \
        'chown dev:dev /home/dev/releases/0.13.0/ntilde-0.13.0-full-images.tar' \
        'exec /usr/sbin/sshd -D -e' \
        > /usr/local/bin/entrypoint.sh \
    && chmod +x /usr/local/bin/entrypoint.sh

CMD ["/usr/local/bin/entrypoint.sh"]
