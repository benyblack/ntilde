<Project>
  <PropertyGroup>
    <Version>0.13.0</Version>
    <AssemblyVersion>0.13.0.0</AssemblyVersion>
    <FileVersion>0.13.0.0</FileVersion>
    <InformationalVersion>0.13.0</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- See CLAUDE.md: the Roslyn build server holds parent pipe handles after exit,
         causing test/CI/Claude-Code Bash captures to hang. Per-project setting only;
         the *outer* dotnet invocation also needs -nodeReuse:false (encoded in
         scripts/build.{ps1,sh}). -->
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Centralized language settings. Individual csproj files no longer need
         to repeat Nullable/ImplicitUsings. -->
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- Every project builds warning-free, so a new warning fails the build (#108, which turned it on
         project by project). Test projects waive a few rules, below. Ntilde.App keeps ILC's own switch
         off: see IlcTreatWarningsAsErrors in its csproj. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true' OR $(MSBuildProjectName.EndsWith('.Tests'))">
    <!-- Tests are allowed extra leeway: xUnit1031 (async-over-sync in fixtures)
         is intentional, CA1707 (underscores in member names) matches our test
         naming convention, CA2007 (ConfigureAwait) is irrelevant in test
         contexts. CA1822, CA1859 and CA1861 (static members, concrete types,
         constant array arguments) are performance rules: they pay off in
         shipped code, and in tests they would only move expected values away
         from the assertions that read them (#108). -->
    <NoWarn>$(NoWarn);xUnit1031;CA1707;CA2007;CA1822;CA1859;CA1861</NoWarn>
  </PropertyGroup>
</Project>
