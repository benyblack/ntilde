---
import Base from '../layouts/Base.astro';
import comparison from '../data/common-core-comparison.json';

const repo = 'https://github.com/benyblack/ntilde';
const evidence = `${repo}/tree/main/${comparison.evidencePath}`;
const qualification = `${repo}/blob/main/docs/qa/terminfo/2026-11-11-core-reverse-wide-results/report.md`;
const statusNames: Record<string, string> = {
  supported: 'Supported', unsupported: 'Unsupported', untestable: 'Untestable',
  'probe-todo': 'Not concluded', 'probe-invalid': 'Invalid measurement', 'not-scheduled': 'Not tested',
};
const statusClass = (status: string) => status === 'supported' ? 'text-emerald-300' : status === 'unsupported' ? 'text-rose-300' : 'text-ink-300';
const date = new Date(comparison.subjects.map(s => s.measuredAt).sort().at(-1)!).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Base title="Compatibility, measured" description="Reproducible terminal compatibility results for Ntilde, iTerm2 and Ghostty, with the same probes and links to the evidence.">
  <section class="container-prose py-16 sm:py-24">
    <p class="font-mono text-sm uppercase tracking-widest text-ntilde-400">Compatibility</p>
    <h1 class="mt-4 max-w-4xl text-4xl font-semibold tracking-tight text-white sm:text-6xl">The same tests.<br />The evidence behind every result.</h1>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-ink-300">Fresh runs of Ntilde, iTerm2 and Ghostty through one versioned terminal test suite. Every result below comes from that suite; missing evidence stays visible.</p>
    <p class="mt-4 text-sm text-ink-400">Measured {date} · macOS {comparison.method.os} · {comparison.method.geometry.cols} columns × {comparison.method.geometry.rows} rows · {comparison.requirementCount} frozen Core feature IDs</p>

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {comparison.subjects.map(subject => (
        <article class="rounded-xl border border-ink-800 bg-ink-900/40 p-6">
          <h2 class="text-xl font-semibold text-white">{subject.label}</h2>
          <p class="mt-1 font-mono text-sm text-ink-400">{subject.version}{subject.id === 'ntilde' && <span class="ml-2 font-sans text-xs">build label</span>}</p>
          <p class="mt-6 text-4xl font-semibold text-white">{subject.counts.supported}<span class="text-lg font-normal text-ink-400"> / {comparison.requirementCount}</span></p>
          <p class="mt-1 text-sm text-emerald-300">Conclusive support in this run</p>
          <div class="mt-5 h-2 overflow-hidden rounded-full bg-ink-800" role="img" aria-label={`${subject.counts.supported} of ${comparison.requirementCount} features supported`}>
            <div class="h-full rounded-full bg-emerald-400" style={`width:${subject.supportedShare}%`}></div>
          </div>
          <dl class="mt-5 grid grid-cols-2 gap-y-2 text-sm">
            <dt class="text-ink-400">Unsupported</dt><dd class="text-right text-ink-200">{subject.counts.unsupported}</dd>
            <dt class="text-ink-400">Not concluded</dt><dd class="text-right text-ink-200">{subject.counts['probe-todo']}</dd>
            <dt class="text-ink-400">Invalid measurement</dt><dd class="text-right text-ink-200">{subject.counts['probe-invalid']}</dd>
            <dt class="text-ink-400">Untestable / not tested</dt><dd class="text-right text-ink-200">{subject.counts.untestable + subject.counts['not-scheduled']}</dd>
          </dl>
          {subject.measurementLimits.captureRefusal && <div class="mt-5 rounded border border-amber-800/60 bg-amber-950/30 p-3 text-xs leading-relaxed text-amber-200">Screenshot calibration was refused. Visual cases remain unconcluded: this count cannot rank terminal support. <details class="mt-2"><summary class="cursor-pointer">Recorded reason</summary><p class="mt-2 break-words">{subject.measurementLimits.captureRefusal}</p></details></div>}
          {subject.counts['probe-invalid'] > 0 && <p class="mt-3 text-xs leading-relaxed text-amber-200">Some measurements were invalid because their controls or capture conditions were not established. {subject.measurementLimits.invalidWindowBoundsCount > 0 && <span> {subject.measurementLimits.invalidWindowBoundsCount} were invalidated after the native window bounds changed.</span>} Expand the affected rows for the recorded reasons.</p>}
          {subject.measurementLimits.withheldProbeCount > 0 && <p class="mt-3 text-xs leading-relaxed text-ink-400">{subject.measurementLimits.withheldProbeCount} probes were withheld under the upstream ownership policy.</p>}
          <a class="mt-5 inline-block text-sm text-ntilde-300 underline underline-offset-4" href={`${evidence}/${subject.id}`}>Inspect this run →</a>
        </article>
      ))}
    </div>

    <div class="mt-8 rounded-xl border border-ink-800 p-6">
      <h2 class="text-lg font-semibold text-white">What the numbers mean</h2>
      <p class="mt-3 max-w-4xl leading-relaxed text-ink-300">Supported means the test obtained the evidence its criterion requires. Unsupported means a valid test observed a mismatch. Not concluded, invalid and untestable results describe limits of the measurement; they are not counted as terminal failures.</p>
      <p class="mt-3 max-w-4xl leading-relaxed text-ink-300">These runs use the same upstream probes and grading rules, on the same host and grid. Observer availability can differ by application; the counts alone do not rank their capabilities. Application versions and configurations are recorded with the evidence. Results apply to those conditions, not every platform, font or possible use of a feature.</p>
    </div>

    <div class="mt-12 flex flex-wrap items-end justify-between gap-6">
      <div><h2 class="text-2xl font-semibold text-white">Every Core result</h2><p class="mt-2 text-ink-400">Expand a feature to see the method and any recorded limitation.</p></div>
      <label class="block text-sm text-ink-300">Find a feature<input id="feature-search" type="search" placeholder="Try cursor, color or tab" class="mt-2 block w-64 rounded-md border border-ink-700 bg-ink-900 px-3 py-2 text-white placeholder:text-ink-500" /></label>
    </div>
    <div class="mt-6 overflow-x-auto rounded-xl border border-ink-800">
      <table class="w-full min-w-[720px] border-collapse text-left text-sm">
        <caption class="sr-only">Common-harness results for all 80 Core features</caption>
        <thead class="bg-ink-900"><tr><th scope="col" class="px-5 py-4 font-medium text-white">Feature</th>{comparison.subjects.map(subject => <th scope="col" class="px-5 py-4 font-medium text-white">{subject.label}</th>)}</tr></thead>
        <tbody>
          {comparison.rows.map(row => (
            <tr data-feature-row data-search={`${row.id} ${row.name}`.toLowerCase()} class="border-t border-ink-800 align-top">
              <th scope="row" class="max-w-sm px-5 py-4 font-normal">
                <details>
                  <summary class="cursor-pointer font-medium text-ink-100">{row.name}</summary>
                  <p class="mt-3 leading-relaxed text-ink-400">Frozen Core reference: {row.requirement}</p><p class="mt-2 text-xs leading-relaxed text-ink-500">The result is decided by the retained upstream application probe, whose criterion may differ from this older reference.</p>
                  <a class="mt-2 inline-block text-ntilde-300 underline underline-offset-4" href={row.url}>Feature definition ↗</a>
                  <p class="mt-2 break-all font-mono text-xs text-ink-500">{row.id}</p>
                </details>
              </th>
              {comparison.subjects.map(subject => {
                const result = row.results[subject.id as keyof typeof row.results];
                return <td class="max-w-xs px-5 py-4"><span class={`font-medium ${statusClass(result.status)}`}>{statusNames[result.status]}</span>{result.method && <p class="mt-2 text-xs text-ink-500">{result.method.replaceAll('_', ' ')}</p>}{result.evidenceLine && <a class="mt-2 block text-xs text-ntilde-300 underline underline-offset-4" href={`${repo}/blob/main/${comparison.evidencePath}/${subject.id}/cases.json#L${result.evidenceLine}`}>Run record ↗</a>}{result.reason && <details class="mt-2 text-xs leading-relaxed text-ink-400"><summary class="cursor-pointer">Measurement note</summary><p class="mt-2 break-words">{result.reason}</p></details>}</td>;
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p id="feature-empty" hidden class="py-6 text-ink-400">No features match your search.</p>

    <section class="mt-12 rounded-xl border border-ntilde-700/50 bg-ntilde-950/30 p-6 sm:p-8" aria-labelledby="deep-qualification">
      <h2 id="deep-qualification" class="text-2xl font-semibold text-white">A deeper look at Ntilde</h2>
      <p class="mt-4 max-w-4xl leading-relaxed text-ink-300">Ntilde also has a separate, detailed qualification of all 80 frozen Core requirements. It combines stored-cell observations, terminal replies, child output and controlled rendering, with independent controls and retained evidence. That 80/80 result is a different measurement and is not used to fill gaps in the comparison above.</p>
      <a class="mt-5 inline-block text-ntilde-300 underline underline-offset-4" href={qualification}>Read the detailed 80/80 qualification →</a>
    </section>

    <details class="mt-10 rounded-xl border border-ink-800 p-6">
      <summary class="cursor-pointer text-lg font-medium text-white">Method, evidence and reproduction</summary>
      <div class="mt-5 space-y-4 leading-relaxed text-ink-300">
        <p>The probes come from <a class="text-ntilde-300 underline" href="https://github.com/beorn/terminfo.dev">terminfo.dev</a>. A recorded local adapter launches disposable application windows, proves ownership and retains native Retina screenshots without resizing. It does not change the feature definitions or grading rules.</p>
        <p>Native screenshots and exact terminal replies are distinct evidence. These are locally collected runs, not entries published by terminfo.dev. These common-harness results do not borrow Ntilde’s private cell readback or its additional qualification graders.</p>
        <p>Source revision: <code class="break-all text-xs">{comparison.method.sourceRevision}</code><br />Suite identity: <code>{comparison.method.probeHash}</code></p>
        <p>Verify the retained report from a repository checkout:</p>
        <pre class="overflow-x-auto rounded bg-ink-950 p-4 text-sm"><code>node scripts/terminfo-common-core-publication.mjs --check</code></pre>
        <p><a class="text-ntilde-300 underline" href={evidence}>Raw runs, source pins, captures and attempt history ↗</a></p>
        <p class="text-sm text-ink-400">Historical scores published elsewhere may use older probes and grading rules. They are not mixed with these measurements.</p>
      </div>
    </details>
  </section>
</Base>

<script>
  const search = document.querySelector<HTMLInputElement>('#feature-search');
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('[data-feature-row]')];
  search?.addEventListener('input', () => {
    const query = search.value.trim().toLowerCase();
    let visible = 0;
    for (const row of rows) {
      row.hidden = !(row.dataset.search ?? '').includes(query);
      if (!row.hidden) visible++;
    }
    const empty = document.querySelector<HTMLElement>('#feature-empty');
    if (empty) empty.hidden = visible !== 0;
  });
</script>
