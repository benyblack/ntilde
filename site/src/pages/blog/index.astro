---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

// Newest first. Drafts stay out of production builds; `npm run dev` shows them.
const posts = (await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const homeHref = (import.meta.env.BASE_URL ?? '/').replace(/\/?$/, '/');
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Base title="Blog" description="Notes from building Ntilde: engineering write-ups, releases and what we learned.">
  <div class="container-prose py-10 lg:py-14">
    <div class="max-w-3xl">
      <h1 class="text-3xl sm:text-4xl">Blog</h1>
      <p class="mt-3 text-ink-300">Notes from building Ntilde.</p>

      {
        posts.length === 0 ? (
          <p class="mt-10 text-ink-400">No posts yet.</p>
        ) : (
          <ul class="mt-10 space-y-8">
            {posts.map((post) => (
              <li class="border-t border-ink-800 pt-8">
                <p class="text-sm text-ink-400">
                  <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
                  {post.data.draft && <span class="ml-2 text-ntilde-300">Draft</span>}
                </p>
                <h2 class="mt-2 text-xl sm:text-2xl">
                  <a href={`${homeHref}blog/${post.slug}/`} class="text-white hover:text-ntilde-200">
                    {post.data.title}
                  </a>
                </h2>
                <p class="mt-2 leading-relaxed text-ink-300">{post.data.description}</p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</Base>
