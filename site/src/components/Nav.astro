---
const navLinks = [
  { href: '#features', label: 'Features' },
  { href: '#how-it-works', label: 'How it works' },
  { href: '#agent-host', label: 'Agent access' },
  { href: '#install', label: 'Install' },
  { href: '#developers', label: 'Developers' },
];

const repoUrl = 'https://github.com/benyblack/ntilde';
// Use the configured base so the home link lands on the deployed site
// even when served from a project Pages path (`/Ntilde/`).
const homeHref = import.meta.env.BASE_URL ?? '/';
---

<header
  class="sticky top-0 z-40 border-b border-ink-900/60 bg-ink-950/70 backdrop-blur supports-[backdrop-filter]:bg-ink-950/50"
>
  <div
    class="container-prose flex h-16 items-center justify-between gap-6"
  >
    <a
      href={homeHref}
      class="flex items-center gap-2.5 text-white hover:text-white"
      aria-label="Ntilde home"
    >
      <span
        class="grid h-8 w-8 place-items-center rounded-md bg-gradient-to-br from-ntilde-500 to-ntilde-700 text-ink-950 shadow-lg shadow-ntilde-900/40"
        aria-hidden="true"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-4 w-4"
        >
          <path d="M4 17l5-5-5-5"></path>
          <path d="M12 19h8"></path>
        </svg>
      </span>
      <span class="font-mono text-base font-semibold tracking-tight">
        Ntilde
      </span>
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm text-ink-300 hover:text-white"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={repoUrl}
        class="btn-ghost hidden sm:inline-flex"
        aria-label="GitHub repository"
      >
        <svg
          viewBox="0 0 24 24"
          fill="currentColor"
          class="h-4 w-4"
          aria-hidden="true"
        >
          <path
            d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.13c-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.41-5.25 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
          ></path>
        </svg>
        <span>GitHub</span>
      </a>
      <a href="#install" class="btn-primary">Install</a>
    </div>
  </div>
</header>
