---
// Release asset names follow the workflows in `.github/workflows/release.yml`:
// installers are `ntilde-Setup-{rid}-{tag}.{exe,pkg}`, portable bundles are
// `ntilde-{rid}-{tag}.zip`, and Linux ships `ntilde-linux-{arch}-{tag}.AppImage`,
// `ntilde-linux-{arch}-{tag}.tar.gz`, and `ntilde_{version}-1_{debarch}.deb`
// from the publish_linux / release_linux lanes. The winget package id lives in
// `packaging/winget/0.3.0/benyblack.ntilde.yaml`.
//
// Ordered Windows, macOS, Linux: the two platforms with an installer come first,
// because that is the path most people should take.
const releases = [
  {
    platform: 'Windows',
    arch: 'x64',
    installer: 'ntilde-Setup-win-x64-<tag>.exe',
    installerNote:
      'Per-user install — no admin prompt. Adds Start Menu and Desktop shortcuts, and updates itself in the background.',
    asset: 'ntilde-win-x64-<tag>.zip',
    cmd: 'winget install benyblack.ntilde',
  },
  {
    platform: 'macOS',
    arch: 'arm64',
    installer: 'ntilde-Setup-osx-arm64-<tag>.pkg',
    installerNote:
      'Installs a proper Ntilde.app bundle, and updates itself in the background. Signed and notarized since v0.7.0, so Gatekeeper opens it with no warnings.',
    asset: 'ntilde-osx-arm64-<tag>.zip',
    cmd:
      'unzip ntilde-osx-arm64-<tag>.zip\n' +
      'open Ntilde.app',
  },
  {
    platform: 'Linux',
    arch: 'x64 · arm64',
    installer: 'ntilde-linux-<x64|arm64>-<tag>.AppImage',
    installerLabel: 'AppImage — recommended',
    installerNote:
      'Self-updating, like the Windows and macOS installers. Needs glibc 2.35+ (Ubuntu 22.04+, Debian 12+, Fedora 36+). Ubuntu 22.04+/Debian 12 ship no FUSE 2 — install it (sudo apt install fuse) or launch with --appimage-extract-and-run.',
    asset: 'ntilde_<version>-1_<amd64|arm64>.deb',
    assetLabel: 'Or the .deb — system integration',
    cmd: 'sudo apt install ./<exact .deb filename from the release page>',
    installerCmd:
      'chmod +x ntilde-linux-<x64|arm64>-<tag>.AppImage\n' +
      './ntilde-linux-<x64|arm64>-<tag>.AppImage',
    extraNote:
      'The .deb adds a desktop entry, icons, the ntilde command on your PATH, and a man page. It does not update itself: there is no APT repository yet, so apt upgrade will not see new releases — download and reinstall each one. Its filename carries both the version and the architecture and changes every release — copy the exact one for your machine (amd64 or arm64) from the release page. A portable .tar.gz is there too.',
  },
];

const buildSteps = [
  {
    title: 'Prerequisites',
    body: '.NET 10 SDK and a stable Rust toolchain. On macOS, install Xcode Command Line Tools. On Windows, MSVC build tools.',
    code: [
      'dotnet --version   # expect 10.x',
      'rustc --version   # expect stable',
      'cargo --version',
    ],
  },
  {
    title: 'Build',
    body: 'dotnet restore triggers a cargo build for the native PTY and SSH libraries automatically.',
    code: [
      'dotnet restore',
      'dotnet build -c Release',
    ],
  },
  {
    title: 'Test',
    body: 'Run the same filter as the blocking CI unit lane (fast, deterministic).',
    code: [
      'dotnet test -c Release --no-build \\',
      '  --filter "Category!=Replay&Category!=RenderMetrics&Category!=PtySmoke&Category!=Stress&Category!=GoldenSharedPng"',
    ],
  },
];
---

<section
  id="install"
  class="section border-b border-ink-900/60"
  aria-labelledby="install-title"
>
  <div class="container-prose">
    <div class="max-w-3xl">
      <span class="eyebrow">Install</span>
      <h2
        id="install-title"
        class="mt-4 text-3xl font-semibold tracking-tight text-white sm:text-4xl"
      >
        Pick a build, get to work.
      </h2>
      <p class="lede mt-4 max-w-2xl">
        Windows and macOS have one-click installers that keep themselves up to
        date — a new version downloads in the background and applies on your next
        restart. Linux ships a self-updating AppImage, a system
        <code class="rounded bg-ink-800/60 px-1.5 py-0.5 text-ntilde-200">.deb</code>, and a portable tarball, for
        <code class="rounded bg-ink-800/60 px-1.5 py-0.5 text-ntilde-200">x64</code> and
        <code class="rounded bg-ink-800/60 px-1.5 py-0.5 text-ntilde-200">arm64</code> alike. Every release runs the gating unit-test lane on all three OSes before any bundle is published. Replace <code class="rounded bg-ink-800/60 px-1.5 py-0.5 text-ntilde-200">&lt;tag&gt;</code> with the version you downloaded.
      </p>
      <p class="mt-4 max-w-2xl text-sm text-ink-400">
        macOS builds are signed and notarized (since v0.7.0), so Gatekeeper
        opens them normally. Windows installers are not code-signed yet, so
        SmartScreen will warn on first run — choose{' '}
        <em>More info → Run anyway</em>; see
        {' '}
        <a
          href="https://github.com/benyblack/ntilde/issues/91"
          rel="noopener"
          class="text-ntilde-300"
        >
          issue #91
        </a>
        .
      </p>
    </div>

    <div class="mt-12 grid gap-4 lg:grid-cols-3">
      {
        releases.map((rel) => (
          <article class="card h-full">
            <div class="flex items-baseline justify-between gap-2">
              <h3 class="text-base font-semibold text-white">
                {rel.platform}
              </h3>
              <span class="font-mono text-xs text-ink-400">{rel.arch}</span>
            </div>
            <p class="mt-2 text-sm text-ink-300">
              Native AOT, self-contained. Download from
              {' '}
              <a
                href="https://github.com/benyblack/ntilde/releases/latest"
                rel="noopener"
                class="text-ntilde-300"
              >
                the latest release
              </a>
              .
            </p>

            {rel.installer && (
              <div class="mt-4">
                <p class="text-xs font-semibold uppercase tracking-wider text-ntilde-300">
                  {rel.installerLabel ?? 'Installer — recommended'}
                </p>
                <p class="mt-1 font-mono text-[11px] text-ink-400">
                  {rel.installer}
                </p>
                <p class="mt-1.5 text-sm text-ink-300">{rel.installerNote}</p>
                {rel.installerCmd && (
                  <pre class="code-block mt-3 text-xs leading-relaxed"><code>{rel.installerCmd}</code></pre>
                )}
              </div>
            )}

            <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-ink-400">
              {rel.assetLabel ?? (rel.installer ? 'Portable — no updater' : 'Portable')}
            </p>
            <p class="mt-1 font-mono text-[11px] text-ink-400">
              {rel.asset}
            </p>
            <pre class="code-block mt-3 text-xs leading-relaxed"><code>{rel.cmd}</code></pre>
            {rel.extraNote && (
              <p class="mt-3 text-xs leading-relaxed text-ink-400">
                {rel.extraNote}
              </p>
            )}
          </article>
        ))
      }
    </div>

    <div class="mt-12 rounded-2xl border border-ink-800 bg-ink-900/40 p-6 sm:p-8">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h3 class="text-xl font-semibold text-white sm:text-2xl">
          Build from source
        </h3>
        <span class="font-mono text-xs text-ink-400">net10.0 · Rust 2024</span>
      </div>
      <div class="mt-6 grid gap-6 lg:grid-cols-3">
        {
          buildSteps.map((step, i) => (
            <div>
              <p class="flex items-center gap-2 text-sm font-semibold text-white">
                <span
                  class="grid h-5 w-5 place-items-center rounded-full bg-ntilde-500/15 font-mono text-[10px] text-ntilde-300"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                {step.title}
              </p>
              <p class="mt-2 text-sm leading-relaxed text-ink-300">
                {step.body}
              </p>
              <pre class="code-block mt-3 text-xs leading-relaxed"><code>{step.code.join('\n')}</code></pre>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
