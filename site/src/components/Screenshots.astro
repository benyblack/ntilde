---
// Astro's `base` config prefixes Vite-managed assets automatically, but
// `public/` references are passed through unchanged. We resolve them
// against `import.meta.env.BASE_URL` so the deployed site works on the
// project Pages URL (`/Ntilde/...`) without changing the source.
const basePrefix = (import.meta.env.BASE_URL ?? '/').endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
// `webp` is set only for the variants that actually have a WebP sibling published in
// docs/assets/shots/ (a sibling is only emitted where it beats its PNG) and mirrored into
// site/public/shots/ by sync-screenshots.mjs. Keep this list and SHOTS_FILES there in step.
const images = [
  { src: `${basePrefix}shots/hero-split-site.png`, webp: `${basePrefix}shots/hero-split-site.webp`, alt: 'Ntilde on macOS with three panes: a test run and Rust source on the left, a git graph top-right and a process table bottom-right' },
  { src: `${basePrefix}shots/command-palette-site.png`, alt: 'The command palette open over a populated terminal, a query typed, and matching commands listed with their keyboard shortcuts' },
  { src: `${basePrefix}shots/sixel-graphics-site.png`, alt: 'A sixel chart rendered inline in the terminal between two shell prompts' },
  { src: `${basePrefix}shots/tui-vim-site.png`, webp: `${basePrefix}shots/tui-vim-site.webp`, alt: 'Vim running full-screen inside Ntilde, editing Rust source with syntax colouring and a status line' },
  { src: `${basePrefix}shots/themes-grid-site.png`, alt: 'A grid of five built-in Ntilde themes rendering the same terminal transcript' },
];
---

<section
  id="screenshots"
  class="section border-b border-ink-900/60 bg-ink-950/40"
  aria-labelledby="screenshots-title"
>
  <div class="container-prose">
    <div class="max-w-3xl">
      <span class="eyebrow">In the wild</span>
      <h2
        id="screenshots-title"
        class="mt-4 text-3xl font-semibold tracking-tight text-white sm:text-4xl"
      >
        Built for the way you actually work.
      </h2>
      <p class="lede mt-4 max-w-2xl">
        From quick REPL sessions to fullscreen TUIs, Ntilde keeps the
        same predictable behavior across operating systems.
      </p>
    </div>

    <div
      class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-6"
      role="list"
    >
      {
        images.map((img, idx) => (
          <figure
            class={
              'group relative overflow-hidden rounded-xl border border-ink-800 bg-ink-900/50 shadow-xl shadow-black/30 ' +
              (idx === 0
                ? 'sm:col-span-2 lg:col-span-4 lg:row-span-2'
                : 'lg:col-span-2')
            }
            role="listitem"
          >
            <picture>
              {img.webp && <source srcset={img.webp} type="image/webp" />}
              <img
                src={img.src}
                alt={img.alt}
                loading="lazy"
                decoding="async"
                class="aspect-video w-full object-cover object-top transition duration-500 group-hover:scale-[1.02]"
              />
            </picture>
            <figcaption
              class="pointer-events-none absolute inset-x-0 bottom-0
                bg-gradient-to-t from-ink-950/95 via-ink-950/40 to-transparent
                px-4 py-3 text-xs text-ink-200 opacity-0 transition
                group-hover:opacity-100"
            >
              {img.alt}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
