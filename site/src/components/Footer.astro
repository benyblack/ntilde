---
const year = new Date().getFullYear();
const repoUrl = 'https://github.com/benyblack/ntilde';

const groups = [
  {
    title: 'Product',
    links: [
      { href: '#features', label: 'Features' },
      { href: '#how-it-works', label: 'How it works' },
      { href: '#agent-host', label: 'Agent access' },
      { href: '#install', label: 'Install' },
    ],
  },
  {
    title: 'Project',
    links: [
      { href: `${repoUrl}`, label: 'Repository' },
      { href: `${repoUrl}#architecture`, label: 'Architecture' },
      { href: `${repoUrl}#build--test`, label: 'Build & test' },
      { href: `${repoUrl}/blob/main/docs/ROADMAP.md`, label: 'Roadmap' },
    ],
  },
  {
    title: 'Docs',
    links: [
      {
        href: `${repoUrl}/blob/main/docs/USER_MANUAL.md`,
        label: 'User manual',
      },
      {
        href: `${repoUrl}/blob/main/docs/SSH_ROADMAP.md`,
        label: 'SSH roadmap',
      },
      {
        href: `${repoUrl}/blob/main/docs/agent-host/DIRECTION.md`,
        label: 'Agent host direction',
      },
    ],
  },
];
---

<footer class="mt-16 border-t border-ink-900/80 bg-ink-950/80">
  <div
    class="container-prose grid gap-10 py-12 sm:grid-cols-2 sm:gap-12 lg:grid-cols-4"
  >
    <div>
      <div class="flex items-center gap-2.5">
        <span
          class="grid h-8 w-8 place-items-center rounded-md bg-gradient-to-br from-ntilde-500 to-ntilde-700 text-ink-950"
          aria-hidden="true"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4"
          >
            <path d="M4 17l5-5-5-5"></path>
            <path d="M12 19h8"></path>
          </svg>
        </span>
        <span class="font-mono text-base font-semibold text-white">
          Ntilde
        </span>
      </div>
      <p class="mt-3 text-sm leading-relaxed text-ink-300">
        A modern, cross-platform terminal emulator focused on
        <span class="text-ink-100">correctness</span>,
        <span class="text-ink-100">performance</span>, and
        <span class="text-ink-100">predictability</span>.
      </p>
      <p class="mt-3 text-xs text-ink-500">
        Built with .NET 10 · Avalonia · Skia · Rust
      </p>
    </div>

    {
      groups.map((group) => (
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-400">
            {group.title}
          </h3>
          <ul class="mt-4 space-y-2.5 text-sm">
            {group.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-ink-200 hover:text-white"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="border-t border-ink-900/80">
    <div
      class="container-prose flex flex-col items-center justify-between gap-3 py-6 text-xs text-ink-400 sm:flex-row"
    >
      <p>© {year} Ntilde contributors. MIT licensed.</p>
      <p>
        A terminal you can trust.
      </p>
    </div>
  </div>
</footer>
