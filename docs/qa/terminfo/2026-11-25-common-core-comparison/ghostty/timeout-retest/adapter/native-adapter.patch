+import { describe, expect, it } from "vitest"
+import { assertITermCellPitch, itermBackingScale } from "./iterm-capture-geometry.ts"
+
+const reported = { cellWidth: 7, cellHeight: 15, textWidth: 990, textHeight: 652 }
+
+describe("owned iTerm2 calibration", () => {
+  it.each([1, 2] as const)("corroborates a %sx painted text grid in its native window", (scale) => {
+    const backing = itermBackingScale(reported, { scale, pointBounds: { width: 990, height: 652 } })
+    expect(backing).toBe(scale)
+    expect(() => assertITermCellPitch(reported, {
+      cellWidth: 7 * scale, cellHeight: 15 * scale, textWidth: 980 * scale, textHeight: 615 * scale,
+    }, backing)).not.toThrow()
+  })
+
+  it("accepts fractional points only where rounding corroborates the witnessed pixel pitch", () => {
+    const measured = { cellWidth: 13, cellHeight: 29, textWidth: 1820, textHeight: 1189 }
+    expect(() => assertITermCellPitch(reported, measured, 2)).not.toThrow()
+    expect(() => assertITermCellPitch(reported, { ...measured, cellWidth: 12 }, 2)).toThrow(/disagrees/)
+  })
+
+  it.each([{}, {scale: 3, pointBounds: { width: 990, height: 652 }},
+    {scale: 2, pointBounds: { width: 989, height: 652 }}])("refuses mismatched or missing native geometry %j", (trace) => {
+    expect(() => itermBackingScale(reported, trace)).toThrow(/disagree/)
+  })
+})
diff --git a/packages/terminfo.dev/src/iterm-capture-geometry.ts b/packages/terminfo.dev/src/iterm-capture-geometry.ts
