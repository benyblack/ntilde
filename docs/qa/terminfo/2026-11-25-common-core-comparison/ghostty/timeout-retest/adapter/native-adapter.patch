index 0000000000000000000000000000000000000000..5ba94551bc750d4aae99482a861148a2f7b85fa0
--- /dev/null
+++ b/packages/terminfo.dev/src/iterm-capture-geometry.ts
@@ -0,0 +1,33 @@
+import type { PixelGeometry } from "@terminfo/probe-defs"
+
+function refuse(message: string): never {
+  const error = new Error(message)
+  error.name = "CaptureCalibrationRefused"
+  throw error
+}
+
+/** iTerm2's CSI 14 t gives the window's point dimensions, including chrome and padding. */
+export function itermBackingScale(reported: PixelGeometry, trace: Record<string, unknown>): 1 | 2 {
+  const { pointBounds, scale } = trace
+  if (
+    (scale !== 1 && scale !== 2) ||
+    typeof pointBounds !== "object" ||
+    pointBounds === null ||
+    !("width" in pointBounds && "height" in pointBounds) ||
+    pointBounds.width !== reported.textWidth ||
+    pointBounds.height !== reported.textHeight
+  ) {
+    refuse("iTerm2's CSI 14 t window dimensions disagree with the owned native screenshot")
+  }
+  return scale
+}
+
+/** CSI 16 t rounds the point pitch. The raster witness supplies the exact whole backing pixels. */
+export function assertITermCellPitch(reported: PixelGeometry, measured: PixelGeometry, scale: 1 | 2): void {
+  if (
+    Math.round(measured.cellWidth / scale) !== reported.cellWidth ||
+    Math.round(measured.cellHeight / scale) !== reported.cellHeight
+  ) {
+    refuse("iTerm2's CSI 16 t cell pitch disagrees with the witnessed backing-pixel grid")
+  }
+}
