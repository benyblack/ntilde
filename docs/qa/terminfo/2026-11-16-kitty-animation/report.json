      "effectContract": {
        "id": "ntilde-kitty-animation-playback-effect-v1",
        "version": 1,
        "statement": "A retained 16x16 raw RGBA image with two further frames added by a=f (z=5000 ms each, root gap 5000 ms) shows its root frame, stays on it past that gap while stopped, then after a=a,s=3 shows the second frame, the third frame and the root frame again at the times its gaps give (measured by paired offscreen captures against the App's wall clock), and after a=a,s=1 stays frozen on the frame it was showing past a hold that would have advanced it; every write is acknowledged OK and every cleared target is blank again.",
        "primary": "https://sw.kovidgoyal.net/kitty/graphics-protocol/#animation",
        "carrierCases": [
          "kitty.animation.stopped-hold",
          "kitty.animation.playback",
          "kitty.animation.stop-freeze"
        ],
        "validity": [
