            "detail": "the exclusive raw reader sealed without failure over every admitted write"
          },
          {
            "name": "state-restored",
            "held": true,
            "detail": "the final paired state is bound to the initial state after every write"
          },
          {
            "name": "controlled-background",
            "held": true,
            "detail": "every write before the final restoration independently queried the matching controlled OSC 11 and cell background; the final control is the restored original theme"
          },
          {
            "name": "fresh-paired-fences",
            "held": true,
            "detail": "every capture carries its own unpredictable paired challenges, none reused from the earlier phases or another capture"
          },
          {
            "name": "blank-before-controls",
            "held": true,
            "detail": "every case began from an independently blank, unchanged-surroundings target"
          },
          {
            "name": "acknowledgement-separate-from-pixels",
            "held": true,
            "detail": "every write was acknowledged by its raw fence while pixel assertions were graded separately"
          },
          {
            "name": "wall-clock-windows-valid",
            "held": true,
            "detail": "every timed read landed wholly inside its planned frame window, measured against retained wall-clock brackets rather than synthetic presentation time"
          }
        ]
      },
