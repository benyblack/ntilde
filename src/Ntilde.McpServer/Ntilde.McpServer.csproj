<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ntilde MCP server: a local stdio MCP server that exposes project knowledge to AI
    coding agents, plus — per the agent-host direction (docs/agent-host/DIRECTION.md, A1) —
    opt-in, observe-only access to live terminal sessions, proxied over the app's local IPC
    endpoint. Solution dependencies are three zero-reference leaves:
    Ntilde.AgentHost.Contracts (wire protocol), Ntilde.Backup (read-only backup
    tools), and Ntilde.VtContract (developer-facing VT capability metadata). This server must never reference
    App, VT, Pty, Rendering, or Ntilde.Platform (Platform pulls in Pty transitively,
    which would silently reopen the same hole a direct Pty reference would - see
    docs/MODULE_OWNERSHIP.md), and must never touch SSH or credentials. Session access is
    read-only and exists only while the user has "Agent access (observe)" enabled in the
    running app.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Ntilde.McpServer</RootNamespace>
    <AssemblyName>Ntilde.McpServer</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ntilde.AgentHost.Contracts\Ntilde.AgentHost.Contracts.csproj" />
    <ProjectReference Include="..\Ntilde.Backup\Ntilde.Backup.csproj" />
    <ProjectReference Include="..\Ntilde.VtContract\Ntilde.VtContract.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ntilde.McpServer.Tests" />
  </ItemGroup>

</Project>
