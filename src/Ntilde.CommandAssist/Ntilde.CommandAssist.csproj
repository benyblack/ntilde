<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Tests only, matching the convention every other src project follows. The App is
         deliberately NOT granted: the two types it needs (CommandAssistKeyRouter,
         CommandAssistInsertionPlanner) are public pure-static helpers, so the App consumes this
         assembly through its public surface and gets no visibility into anything else. -->
    <InternalsVisibleTo Include="Ntilde.App.Tests" />
  </ItemGroup>

  <!-- Remote shell-integration snippets (V2 Phase 2b). Authored as plain files under
       assets/shell-integration/ so they are reviewable and diffable as the shell scripts they are,
       and embedded here because the only consumer is a clipboard copy from Settings and the app
       publishes AOT/single-file, where a resource stream is the one form guaranteed to survive.
       LogicalName is pinned rather than derived: the default would encode the ".." path walk.
       See ShellIntegration/Remote/RemoteShellIntegrationSnippets.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\assets\shell-integration\ntilde-shell-integration.sh"
                      LogicalName="Ntilde.CommandAssist.ShellIntegration.Remote.ntilde-shell-integration.sh" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\assets\shell-integration\ntilde-shell-integration.fish"
                      LogicalName="Ntilde.CommandAssist.ShellIntegration.Remote.ntilde-shell-integration.fish" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\assets\shell-integration\ntilde-shell-integration.ps1"
                      LogicalName="Ntilde.CommandAssist.ShellIntegration.Remote.ntilde-shell-integration.ps1" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\assets\shell-integration\install\ntilde-install.sh"
                      LogicalName="Ntilde.CommandAssist.ShellIntegration.Remote.ntilde-install.sh" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\assets\shell-integration\install\ntilde-install-fish.sh"
                      LogicalName="Ntilde.CommandAssist.ShellIntegration.Remote.ntilde-install-fish.sh" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\assets\shell-integration\install\ntilde-install.ps1"
                      LogicalName="Ntilde.CommandAssist.ShellIntegration.Remote.ntilde-install.ps1" />
  </ItemGroup>

  <!-- Bundled offline command-knowledge catalogue (V2 Phase 4b, closes #250). Generated from a
       tldr-pages checkout by scripts/generate-command-catalogue.ps1 and committed, so a build
       needs no network and no submodule. Embedded for the same reason the shell-integration
       snippets are: the app publishes AOT/single-file, where a resource stream is the one form
       guaranteed to survive, and the only consumer is CommandKnowledgeService reading it into
       memory. LogicalName is pinned because the default would encode the ".." path walk; it must
       match CommandKnowledgeService.CatalogueResourceName.

       The supplement file is NOT embedded: it is generator input, already merged into the output. -->
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\assets\command-knowledge\command-catalogue.json"
                      LogicalName="Ntilde.CommandAssist.CommandKnowledge.command-catalogue.json" />
  </ItemGroup>

</Project>
