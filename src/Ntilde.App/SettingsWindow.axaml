<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:Ntilde.Settings"
        x:Class="Ntilde.SettingsWindow"
        Title="Settings"
        Width="880" Height="620"
        MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#16181d"
        Foreground="#e6e8ec"
        FontFamily="Inter, Segoe UI, system-ui, sans-serif">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <settings:NtPalette/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <settings:NtStyles/>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto">

        <!-- ╭───────── Body: sidebar + pages ─────────╮ -->
        <Grid Grid.Row="0" ColumnDefinitions="208,*">

            <Border Grid.Column="0"
                    Background="{StaticResource NtChromeBg}"
                    BorderBrush="{StaticResource NtHairline}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBox Name="SettingsSearchBox"
                             DockPanel.Dock="Top"
                             Margin="12,12,12,4"
                             PlaceholderText="Search settings"
                             AutomationProperties.Name="Search settings">
                        <!-- The mouse's way out of a search; Esc is the keyboard's. Not focusable, so a click leaves focus
                             in the box and Tab never stops on it. Shown while the box holds text (set in code). -->
                        <TextBox.InnerRightContent>
                            <Button Name="SearchClearButton" Classes="IconBtn" Width="22" Height="22" Padding="0" Margin="0,0,4,0"
                                    Focusable="False" IsVisible="False"
                                    AutomationProperties.Name="Clear search" ToolTip.Tip="Clear search (Esc)">
                                <TextBlock Text="✕" FontSize="12"/>
                            </Button>
                        </TextBox.InnerRightContent>
                    </TextBox>
                    <!-- Items are built from SettingsPageRegistry in code. -->
                    <ListBox Name="SideNav"
                             Classes="SideNav"
                             SelectionMode="Single"
                             Padding="0,4,0,8"
                             AutomationProperties.Name="Settings pages"/>
                </DockPanel>
            </Border>

            <Panel Grid.Column="1">
                <!-- Every page lives here for the window's lifetime; only the current one is visible.
                     Keeping them all in the tree is what lets FindResource and DynamicResource work for
                     pages that are not on screen - Save collects from all of them. -->
                <Panel Name="PageHost"/>

                <!-- Shown in place of the page while the search box has text. -->
                <Grid Name="SearchResultsView" RowDefinitions="Auto,*" Margin="32,28,32,0" IsVisible="False">
                    <!-- Focus stays in the search box while these change, so they are polite live regions: a screen
                         reader reads the count, or that nothing matched, between keystrokes. -->
                    <TextBlock Name="SearchResultsHeading" Classes="H1" FontSize="16" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
                    <!-- The result that ↑/↓ in the box selects, read out the same way. Invisible: the list already shows it. -->
                    <TextBlock Name="SearchSelectionAnnouncer" Height="1" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False"
                               AutomationProperties.LiveSetting="Polite"/>
                    <ListBox Name="SearchResultsList" Grid.Row="1" Classes="SearchResults" AutomationProperties.Name="Search results"/>
                    <TextBlock Name="SearchNoResults" Grid.Row="1" Classes="Subtitle" VerticalAlignment="Top" IsVisible="False" AutomationProperties.LiveSetting="Polite"/>
                </Grid>
            </Panel>
        </Grid>

        <!-- ╭───────── Footer ─────────╮ -->
        <Border Grid.Row="1"
                Background="{StaticResource NtChromeBg}"
                BorderBrush="{StaticResource NtHairline}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="Changes apply live."
                           Foreground="{StaticResource NtFg3}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <Button Name="BtnCancel" Grid.Column="1" Classes="Pill" Content="Cancel" Width="100" Margin="0,0,8,0"
                        ToolTip.Tip="Reverts preview changes. Themes, snippets, history and backups are saved as you change them."/>
                <Button Name="BtnSave" Grid.Column="2" Classes="Primary" Content="Save" Width="100"/>
            </Grid>
        </Border>
    </Grid>
</Window>
