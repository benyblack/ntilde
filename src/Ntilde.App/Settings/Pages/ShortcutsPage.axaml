<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:Ntilde.Settings"
             x:Class="Ntilde.Settings.Pages.ShortcutsPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28" Spacing="0">
            <StackPanel Margin="0,0,0,24">
                <TextBlock Classes="H1" Text="Shortcuts"/>
                <TextBlock Classes="Subtitle" Margin="0,4,0,0" Text="Manage app, pane, and Command Assist keybindings."/>
            </StackPanel>

            <TextBlock Classes="SectionHeader" Text="KEYBINDINGS" Margin="0,0,0,14"/>

            <StackPanel Spacing="10" Margin="0,0,0,16">
                <TextBox Name="ShortcutSearchInput" PlaceholderText="Search commands, categories, or scopes"/>
                <TextBlock Name="ShortcutValidationMessage"
                           Foreground="{DynamicResource NtRed}"
                           FontSize="12"
                           IsVisible="False"
                           TextWrapping="Wrap"/>
                <TextBlock Classes="RowDesc"
                           Text="Select a shortcut field and press the new key chord. Reset restores the default binding."/>
                <TextBlock Classes="RowDesc"
                           TextWrapping="Wrap"
                           Text="Command Assist chords are matched while a suggestion surface is open, after the terminal has had its turn at the key. A chord the terminal sends to the shell first - most Ctrl+letter combinations, and anything the kitty keyboard protocol encodes for a full-screen program - will look bound here but never fire. Prefer Esc, the arrow keys, Enter, function keys, or a chord with Alt."/>
            </StackPanel>

            <StackPanel Name="ShortcutBindingsPanel" Spacing="10"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
