<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:Ntilde.Settings"
             x:Class="Ntilde.Settings.Pages.ShortcutsPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28" Spacing="0">
            <StackPanel Margin="0,0,0,24">
                <TextBlock Classes="H1" Text="Shortcuts"/>
                <TextBlock Classes="Subtitle" Margin="0,4,0,0" Text="Manage app, pane, and Command Assist keybindings."/>
            </StackPanel>

            <TextBlock Classes="SectionHeader" Text="KEYBINDINGS" Margin="0,0,0,14"/>

            <StackPanel Spacing="10" Margin="0,0,0,16">
                <TextBox Name="ShortcutSearchInput" PlaceholderText="Search commands, categories, or scopes"/>
                <TextBlock Name="ShortcutValidationMessage"
                           Foreground="{DynamicResource NtRed}"
                           FontSize="12"
                           IsVisible="False"
                           TextWrapping="Wrap"/>
                <settings:SettingRow RowId="keybindings" BorderThickness="0" Padding="0,4"
                                     Title="Recording a shortcut"
                                     Description="Select a shortcut field and press the new key chord. Reset restores the default binding."
                                     Details="Command Assist chords are matched while a suggestion surface is open, after the terminal has had its turn at the key. A chord the terminal sends to the shell first - most Ctrl+letter combinations, and anything the kitty keyboard protocol encodes for a full-screen program - will look bound here but never fire. Prefer Esc, the arrow keys, Enter, function keys, or a chord with Alt. Esc on its own is recorded only for the five keys used inside the suggestion list (Close, Previous and Next Suggestion, Accept While Browsing, Insert Selection). On every other row it cancels, because those shortcuts act before the terminal sees the key; add a modifier, such as Shift+Esc, to bind it there. Tab and Shift+Tab move between fields; Tab with Ctrl, Alt or Cmd is recorded."
                                     Keywords="keybinding hotkey chord rebind"/>
            </StackPanel>

            <StackPanel Name="ShortcutBindingsPanel" Spacing="10"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
