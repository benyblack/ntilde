<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Ntilde.Shell"
             x:Class="Ntilde.Controls.TransferCenter">
    <Grid RowDefinitions="Auto,*">
        <Border Background="{DynamicResource NtChromeBg}" BorderBrush="{DynamicResource NtHairline}" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="BtnClearFinished"
                        Content="Clear Finished"
                        Padding="8,2"
                        FontSize="10"/>
                <Button Name="BtnClearFailed"
                        Content="Clear Failed"
                        Padding="8,2"
                        FontSize="10"/>
                <Button Name="BtnClearInactive"
                        Content="Clear Inactive"
                        Padding="8,2"
                        FontSize="10"/>
            </StackPanel>
        </Border>

        <ListBox Name="JobsList" Grid.Row="1" Background="{DynamicResource NtOverlay}" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:TransferJob">
                    <Border BorderBrush="{DynamicResource NtHairline}" BorderThickness="0,0,0,1" Padding="10">
                        <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto">
                            <!-- Icon -->
                            <TextBlock Text="{Binding Direction, Converter={StaticResource DirectionConverter}}" 
                                       Foreground="{DynamicResource NtFg3}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            
                            <!-- Info -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource NtFg}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource NtFg2}" FontSize="11"/>
                                <TextBlock Text="{Binding RemotePathText}" Foreground="{DynamicResource NtFg3}" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding LocalPathText}" Foreground="{DynamicResource NtFg3}" FontSize="11" TextWrapping="Wrap"/>
                                
                                <ProgressBar Margin="0,5" Height="4" 
                                           Value="{Binding Progress}" Minimum="0" Maximum="1"
                                           IsIndeterminate="{Binding IsProgressIndeterminate}"
                                           IsVisible="{Binding State, Converter={StaticResource RunningConverter}}"/>
                                
                                <TextBlock Text="{Binding LastError}" Foreground="{DynamicResource NtError}" FontSize="10" 
                                           IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            
                            <!-- Status -->
                            <StackPanel Grid.Column="2" Grid.Row="0" Spacing="6" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding State}" 
                                           Foreground="{Binding State, Converter={StaticResource StateBrushConverter}}"
                                           FontSize="11" HorizontalAlignment="Right"/>
                                <Button Content="Cancel"
                                        Padding="8,2"
                                        FontSize="10"
                                        Click="CancelTransfer_Click"
                                        IsVisible="{Binding CanCancel}"/>
                                <Button Content="Remove"
                                        Padding="8,2"
                                        FontSize="10"
                                        Click="RemoveTransfer_Click"
                                        IsVisible="{Binding CanRemove}"/>
                            </StackPanel>
                            
                            <!-- Profile -->
                            <TextBlock Grid.Column="1" Grid.Row="1" 
                                       Text="{Binding ProfileName}" Foreground="{DynamicResource NtFg4}" FontSize="10" Margin="0,2,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
